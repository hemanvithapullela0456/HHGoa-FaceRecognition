# ---- Search (SerpApi: Google Lens + Yandex Images) ----
SERPAPI_KEY=

# ---- IPFS pinning (Pinata) ----
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# ---- Blockchain: Ethereum Sepolia by default (any EVM testnet works) ----
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
EXPLORER_URL=https://sepolia.etherscan.io
DEPLOYER_PRIVATE_KEY=
# Populated by `faceprov deploy`; also mirrored in deployments.json
ATTESTATION_REGISTRY_ADDRESS=

# To target Base Sepolia instead:
#   RPC_URL=https://sepolia.base.org
#   CHAIN_ID=84532
#   EXPLORER_URL=https://sepolia.basescan.org

# ---- Pipeline tuning ----
FACEPROV_MATCH_THRESHOLD=0.36
FACEPROV_MAX_CANDIDATES=12
